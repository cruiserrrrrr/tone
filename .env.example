# Переменные для docker-compose (локальная инфраструктура).
# Скопируй в .env и подставь свои значения: cp .env.example .env

# PostgreSQL. Эти значения должны совпадать с DATABASE_* в backend/.env
POSTGRES_USER=tone
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tone_postgres
POSTGRES_PORT=6543

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=8080

# Mailpit (SMTP-заглушка): SMTP на 1026, веб-интерфейс на 8026
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
