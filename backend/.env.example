# ---- Приложение ----
NODE_ENV=development
PORT=3001
API_PREFIX=api
BODY_LIMIT=10mb
# Список разрешённых origin через запятую. Пусто = разрешён любой origin (только для локальной разработки).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ---- База данных ----
DATABASE_HOST=127.0.0.1
DATABASE_PORT=6543
DATABASE_USERNAME=tone
DATABASE_PASSWORD=change_me
DATABASE_NAME=tone_postgres

# ---- Авторизация ----
JWT_SECRET=change_me_to_a_long_random_string
# TTL токенов в секундах (используется и для JWT, и для maxAge кук)
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=604800

# ---- Почта (SMTP) ----
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=false
FROM_EMAIL=no-reply@example.com

# ---- Yandex Cloud AI ----
YANDEX_AI_API_TEST_KEY=
YANDEX_CLOUD_FOLDER_KEY=
YANDEX_AI_BASE_URL=https://rest-assistant.api.cloud.yandex.net/v1
YANDEX_AI_MODEL=yandexgpt/latest
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=500
# Системный промпт ассистента. Пусто = используется дефолт из src/services/ai.service.ts
AI_SYSTEM_PROMPT=

# ---- CryptoCloud ----
CRYPTO_CLOUD_API_KEY=
CRYPTO_CLOUD_SHOP_ID=
CRYPTO_CLOUD_INVOICE_URL=https://api.cryptocloud.plus/v2/invoice/create

# ---- Подмена домена в ответах API ----
# Обе переменные пустые = интерцептор ничего не подменяет.
URL_REPLACEMENT_SOURCE=
URL_REPLACEMENT_TARGET=
